diff --git a/scripts/checks/treesitter_multilang.lua b/scripts/checks/treesitter_multilang.lua
new file mode 100644
--- /dev/null
+++ b/scripts/checks/treesitter_multilang.lua
@@ -0,0 +1,136 @@
+return function()
+	local api, query = vim.api, vim.treesitter.query
+	local cache = require("user.core.treesitter_predicates")
+	local samples = {
+		lua = [[---@param value string
+local VALUE = math.pi
+local M = {}
+function M.value(self, input)
+  assert(type(input) == "string", "雪")
+  return string.format("%s", input), VALUE
+end
+return M]],
+		c = [[#include <stdio.h>
+#define VALUE 42
+typedef struct Item { int value; } Item;
+int main(void) {
+  Item item = { VALUE };
+  printf("%d", item.value);
+  return 0;
+}]],
+		cpp = [[#include <vector>
+constexpr int VALUE = 42;
+template <typename T> class Item {
+public:
+  std::vector<T> values;
+  auto count() const -> size_t { return values.size(); }
+};
+auto item = std::make_unique<Item<int>>();]],
+		go = [[package main
+import "fmt"
+const VALUE = 42
+type Item struct { Value int }
+func main() {
+  item := &Item{Value: VALUE}
+  if item != nil { fmt.Println(item.Value) }
+}]],
+		java = [[import java.util.List;
+public class Example {
+  private static final int VALUE = 42;
+  public String format(List<String> items) {
+    return String.join(",", items) + VALUE;
+  }
+}]],
+		javascript = [[/** @param {string} name */
+const VALUE = 42;
+export class Item extends Object {
+  async run(name) {
+    const value = await Promise.resolve(`${name}: 雪`);
+    return /[a-z]+/i.test(value) ? this.name : null;
+  }
+}]],
+		typescript = [[type Item<T> = { value: T; name?: string };
+const VALUE: number = 42;
+interface Store { get(): Promise<Item<string>>; }
+export async function run(store: Store): Promise<string> {
+  const item = await store.get();
+  return item.name ?? String(VALUE);
+}]],
+		tsx = [[import React from "react";
+const VALUE = 42;
+type Props = { title: string; onClick(): void };
+export function Card({ title, onClick }: Props) {
+  return <section data-value={VALUE}>
+    <button onClick={onClick}>{title.toUpperCase()}</button>
+  </section>;
+}]],
+		rust = [[use std::collections::HashMap;
+const VALUE: usize = 42;
+#[derive(Debug)]
+struct Item<'a> { name: &'a str }
+impl<'a> Item<'a> {
+  fn value(&self) -> Option<usize> {
+    println!("{} 雪", self.name);
+    Some(VALUE)
+  }
+}]],
+	}
+	local function captures(q, root, buf, first, last)
+		local result = {}
+		for id, node, metadata in q:iter_captures(root, buf, first or 0, last or -1) do
+			result[#result + 1] = { q.captures[id], { node:range() }, vim.deepcopy(metadata) }
+		end
+		return result
+	end
+	local buffers = {}
+	for _, lang in ipairs(vim.tbl_keys(samples)) do
+		local native = query.get(lang, "highlights")
+		assert(not cache.is_enabled(lang), "A different language's setup enabled " .. lang)
+		assert(cache.setup(lang) and cache.is_enabled(lang), "Cache setup failed: " .. lang)
+		local cached = query.get(lang, "highlights")
+		assert(cache.setup(lang) and query.get(lang, "highlights") == cached, "Setup was not idempotent: " .. lang)
+		local buf = api.nvim_create_buf(true, false)
+		local lines = vim.split(samples[lang], "\n", { plain = true })
+		api.nvim_buf_set_lines(buf, 0, -1, false, lines)
+		local function compare()
+			local root = vim.treesitter.get_parser(buf, lang):parse()[1]:root()
+			for first = 0, #lines - 1 do
+				assert(
+					vim.deep_equal(
+						captures(native, root, buf, first, first + 3),
+						captures(cached, root, buf, first, first + 3)
+					),
+					"Viewport captures/ranges/metadata changed: " .. lang
+				)
+			end
+		end
+		compare()
+		for _, name in ipairs({ "value", "VALUE" }) do
+			api.nvim_buf_set_lines(
+				buf,
+				0,
+				-1,
+				false,
+				vim.split(samples[lang]:gsub("VALUE", name), "\n", { plain = true })
+			)
+			compare()
+		end
+		buffers[#buffers + 1] = { buf = buf, compare = compare }
+	end
+	-- Shared memory limits must not mix results across language queries or
+	-- drop cleanup handlers when a second language is initialized.
+	for _, item in ipairs(buffers) do
+		item.compare()
+		api.nvim_buf_delete(item.buf, { force = true })
+	end
+	assert(#api.nvim_get_autocmds({ group = "user_scroll_query_cache" }) == 2, "Languages duplicated cleanup handlers")
+	local native = query.get("toml", "highlights")
+	assert(not cache.setup("toml"), "A query with no supported predicates was changed")
+	assert(query.get("toml", "highlights") == native, "Unchanged query was replaced")
+	local explicit = "(identifier) @test.override"
+	query.set("lua", "highlights", explicit)
+	assert(not cache.is_enabled("lua") and not cache.setup("lua"), "A later explicit query was replaced")
+	assert(query.get("lua", "highlights") == query.parse("lua", explicit), "Explicit override was not retained")
+	assert(cache.is_enabled("python"), "Overriding Lua disabled another language")
+	print("Nine-language predicate parity, inherited queries, edits, shared eviction and explicit overrides passed")
+end
